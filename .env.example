APP_NAME="Smart Campus Portal"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Leave APP_URL blank: the portal builds links from the address each visitor typed (localhost OR the LAN IP).
APP_URL=

LOG_CHANNEL=single
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_DATABASE defaults to database/database.sqlite (works on any path, incl. Arabic folder names)

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
CACHE_STORE=database
QUEUE_CONNECTION=database

# false = plain http works on the LAN. Set true only when the site is served over HTTPS.
FORCE_HTTPS=false

# ---- University SSO (OAuth2). Defaults use the bundled mock server on port 8001. ----
# {host} is replaced by the address the visitor used, so it works from phones/other PCs on the network.
SSO_CLIENT_ID=smart-campus-portal
SSO_CLIENT_SECRET=local-dev-secret
# Leave blank to auto-detect (http://<visitor-address>:8000/auth/sso/callback). Set it only if your real IdP needs a fixed URL.
SSO_REDIRECT_URI=
SSO_AUTHORIZE_URL="http://{host}:8001/idp/authorize"
SSO_TOKEN_URL=http://127.0.0.1:8001/idp/token
SSO_USERINFO_URL=http://127.0.0.1:8001/idp/userinfo
SSO_LOGOUT_URL="http://{host}:8001/idp/logout"
SSO_SCOPES="openid profile email"

# ---- Legacy back-ends (server-side calls, so 127.0.0.1 is correct) ----
SIS_API_ENDPOINT=http://127.0.0.1:8001/sis
LMS_API_ENDPOINT=http://127.0.0.1:8001/lms
LIBRARY_API_ENDPOINT=http://127.0.0.1:8001/library

CAMPUS_CACHE_TTL=3600
CAMPUS_HTTP_TIMEOUT=2
DEMO_MODE=true

# Trust the HTTPS proxy of a tunnel/host so links and cookies use https (harmless on a plain LAN)
TRUSTED_PROXIES=*
