# ---- Smart Campus Portal: env settings ----
# ADD the keys below to your .env.
# Defaults point at the bundled mock server:  php -S 127.0.0.1:8001 mock-server/router.php
#
# IMPORTANT: these three keys already exist in Laravel's default .env - EDIT them in place
# (a duplicate later in the file is ignored, the first occurrence wins):
#   APP_URL=http://localhost:8000
#   SESSION_ENCRYPT=true          # RSK-02: encrypt session payloads at rest
#   QUEUE_CONNECTION=database     # needed for the grade-sync job (RSK-05)

SSO_CLIENT_ID=smart-campus-portal
SSO_CLIENT_SECRET=local-dev-secret
SSO_REDIRECT_URI=http://localhost:8000/auth/sso/callback
SSO_AUTHORIZE_URL=http://127.0.0.1:8001/idp/authorize
SSO_TOKEN_URL=http://127.0.0.1:8001/idp/token
SSO_USERINFO_URL=http://127.0.0.1:8001/idp/userinfo
SSO_LOGOUT_URL=http://127.0.0.1:8001/idp/logout
SSO_SCOPES="openid profile email"

SIS_API_ENDPOINT=http://127.0.0.1:8001/sis
LMS_API_ENDPOINT=http://127.0.0.1:8001/lms
LIBRARY_API_ENDPOINT=http://127.0.0.1:8001/library

CAMPUS_CACHE_TTL=3600
CAMPUS_HTTP_TIMEOUT=2


APP_ENV=local
APP_DEBUG=true
APP_KEY=base64:QiUg+PcfM/QY06U+5t829pNloAhi9wWvDKXnotj7b5o=
