# Environment variables for a hosted deployment (set them in the hosting dashboard - never commit real values).
APP_NAME="Smart Campus Portal"
APP_ENV=production
APP_DEBUG=false
# php artisan key:generate --show   (or leave empty: the container creates a temporary key)
APP_KEY=
FORCE_HTTPS=true
TRUSTED_PROXIES=*
SESSION_SECURE_COOKIE=true
SESSION_ENCRYPT=true
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=sync
LOG_CHANNEL=stderr
DB_CONNECTION=sqlite
DEMO_MODE=true
ADMIN_PASSWORD=choose-a-strong-password
